# Learnium PROD stack env — template.
#
# On the VM: copy to `prod.env` next to docker-compose.azure.yml, fill in
# the real values, then `chmod 600 prod.env`. The filled file lives ONLY on
# the VM — never commit it, never send it in chat or email.
#
# Generate the secrets on the VM itself:
#   JWT_SECRET / PLATFORM_PROVISIONING_KEY:  openssl rand -base64 64
#   OUTBOX_ENCRYPTION_KEY:                   openssl rand -base64 32

# --- Compose wiring (read by docker compose itself) ---
ENV_FILE=prod.env
FRONTEND_PORT=80

# --- Application ---
# Demo profile stays ON until the first real centre onboards: it seeds the
# demo centre + logins (admin@demo.learnium.local / Demo@123).
SPRING_PROFILES_ACTIVE=demo
PORT=8080

# Prod database: Azure Database for PostgreSQL Flexible Server (Canada Central)
DB_URL=jdbc:postgresql://learnium-prod-pg.postgres.database.azure.com:5432/learnium?sslmode=require
DB_USERNAME=learniumadmin
DB_PASSWORD=<prod-db-password-from-your-password-manager>

JWT_SECRET=<generate-on-the-vm>
OUTBOX_ENCRYPTION_KEY=<generate-on-the-vm>
# Blank = platform onboarding endpoint disabled (returns 404).
PLATFORM_PROVISIONING_KEY=<generate-on-the-vm>

# Public address of this stack; used in emailed set-password links.
APP_PUBLIC_BASE_URL=http://learnium-demo.canadacentral.cloudapp.azure.com

# --- Mail (Resend; filled in deployment Step 3) ---
# Until MAIL_PASSWORD holds a real Resend API key, emails are recorded in
# the outbox but cannot be delivered — invites/resets won't arrive.
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=<resend-api-key-step-3>
MAIL_FROM=<verified-sender-step-3>
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# --- File storage (local volume for now; deployment Step 2 revisits) ---
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=/app/data/files

# --- AI generation stays OFF until the Gemini billing account is fixed ---
GENERATION_WORKER_ENABLED=false

# No metrics export endpoint on the VM yet (Grafana step comes later).
OTEL_EXPORTER_OTLP_ENDPOINT=
