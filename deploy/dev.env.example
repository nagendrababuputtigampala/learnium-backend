# Learnium DEV stack env — template.
#
# On the VM: copy to `dev.env` next to docker-compose.azure.yml, fill in
# the real values, then `chmod 600 dev.env`. The filled file lives ONLY on
# the VM — never commit it, never send it in chat or email.
#
# Dev values are separate from prod on purpose: different database, different
# JWT secret (dev logins must never work on prod and vice versa), different
# public port (8081).

# --- Compose wiring (read by docker compose itself) ---
ENV_FILE=dev.env
FRONTEND_PORT=8081

# --- Application ---
SPRING_PROFILES_ACTIVE=demo
PORT=8080

# Dev database: Neon Free project (direct, non-pooled endpoint — Flyway
# migrates at boot). Host looks like ep-<name>-<id>.us-west-2.aws.neon.tech
DB_URL=jdbc:postgresql://<neon-direct-host>:5432/learnium?sslmode=require
DB_USERNAME=<neon-role-from-connection-string>
DB_PASSWORD=<neon-password-from-your-password-manager>

JWT_SECRET=<generate-on-the-vm-different-from-prod>
OUTBOX_ENCRYPTION_KEY=<generate-on-the-vm>
PLATFORM_PROVISIONING_KEY=

# Dev stack is reached on the VM's port 8081.
APP_PUBLIC_BASE_URL=http://learnium-demo.canadacentral.cloudapp.azure.com:8081

# --- Mail (Resend; filled in deployment Step 3) ---
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=<resend-api-key-step-3>
MAIL_FROM=<verified-sender-step-3>
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# --- File storage (local volume; dev and prod volumes are separate) ---
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=/app/data/files

# --- AI generation stays OFF until the Gemini billing account is fixed ---
GENERATION_WORKER_ENABLED=false

OTEL_EXPORTER_OTLP_ENDPOINT=
