<?xml version="1.0" encoding="UTF-8"?>
<!--
  Structured JSON logging. Every line is a single JSON object carrying level, logger,
  thread, message, stack trace (when present) and the MDC correlation keys traceId /
  requestId (populated by TraceIdFilter). Secrets and raw student answer text are never
  logged — IDs only (see README conventions).
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>requestId</includeMdcKeyName>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
